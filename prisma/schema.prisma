// Prisma Schema für DuelPath
// Yu-Gi-Oh! Kartendatenbank, Deck-Verwaltung und Combo-Editor (nur TCG)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Aufzählungen bleiben vorerst Strings und werden per zod validiert
// DeckSection: "MAIN" | "EXTRA" | "SIDE"

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // Gehasht, falls E-Mail/Passwort-Auth verwendet wird
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  decks    Deck[]
  combos   Combo[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Yu-Gi-Oh! Card Model (nur TCG-Karten)
model Card {
  id            String    @id @default(cuid())
  name          String
  nameDe        String?
  type          String // z.B. "Normal Monster", "Effect Monster", "Spell Card", etc.
  race          String? // Monster-Typ oder Spell/Trap-Kategorie
  attribute     String? // LIGHT, DARK, EARTH, etc. (nur bei Monstern)
  level         Int? // Level/Rang/Linkzahl
  atk           Int? // Angriffspunkte
  def           Int? // Verteidigungspunkte
  desc          String? // Kartentext (englisch, Grundlage für die Effektzerlegung)
  descDe        String?
  archetype     String? // Archetype, falls vorhanden
  banTcg        String? // "Forbidden" | "Limited" | "Semi-Limited", null = unbeschränkt
  tcgDate       DateTime?
  effects       Json? // ParsedEffects aus src/lib/cards/effects.ts
  effectsReview Boolean   @default(false) // Zerlegung unsicher, manuell prüfen
  effectsJev    Float? // Jev-Bewertung der Zerlegung (0..1)
  imageUrl      String? // lokaler Bild-Cache, /api/card-images/<passcode>.jpg
  imageSmall    String? // lokaler Bild-Cache, /api/card-images/<passcode>_small.jpg
  passcode      String?   @unique // YGOPRODeck Passcode-ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deckCards DeckCard[]

  // ponytail: Namenssuche per ILIKE ohne Trigramm-Index; bei ~14k Karten schnell genug, pg_trgm-GIN-Index wenn die Suche spürbar langsam wird
  @@index([name])
  @@index([type])
  @@index([archetype])
}

// Deck Model
model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  format      String   @default("TCG")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckCards DeckCard[]
  combos    Combo[]

  @@index([userId])
}

// Many-to-Many zwischen Deck und Card
model DeckCard {
  id          String @id @default(cuid())
  deckId      String
  cardId      String
  quantity    Int    @default(1) // Anzahl (1-3)
  deckSection String @default("MAIN") // "MAIN", "EXTRA" oder "SIDE"

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId, deckSection])
  @@index([deckId, deckSection])
  @@index([cardId])
}

// Combo als Baum. Der Gamestate wird nicht gespeichert, sondern mit stateAt
// (src/lib/combo/state.ts) aus startState und den Knoten auf dem Pfad berechnet.
model Combo {
  id         String   @id @default(cuid())
  title      String
  userId     String
  deckId     String?
  startState Json // StartState: Starthand, optional Gegnerboard
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck  Deck?       @relation(fields: [deckId], references: [id], onDelete: SetNull)
  nodes ComboNode[]

  @@index([userId])
  @@index([deckId])
}

model ComboNode {
  id           String   @id @default(cuid())
  comboId      String
  parentId     String? // null = Wurzel
  kind         String // ACTION | ACTIVATE | OPPONENT | RESOLVE | END
  player       String // self | opponent
  edgeLabel    String? // "Keine Reaktion", "Ash Blossom", ...
  instanceId   String? // aktivierende Karteninstanz
  cardId       String?
  effectIndex  Int?
  action       String? // NORMAL_SUMMON | SPECIAL_SUMMON | SET | OTHER
  costMoves    Json     @default("[]") // CardMove[] bei Aktivierung
  resolveMoves Json     @default("[]") // CardMove[] bei Auflösung
  negates      Json? // Negation
  optOverride  Boolean? // manueller Eingriff in die OPT-Regel
  note         String?
  createdAt    DateTime @default(now())

  combo    Combo       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  parent   ComboNode?  @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children ComboNode[] @relation("Tree")

  @@index([comboId])
  @@index([parentId])
}
